# ─────────────────────────────────────────────
# CYA Admin — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────
# Local Docker (default):
MONGODB_URI=mongodb://mongo:27017/cyadmin
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/cyadmin?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── Plaid ────────────────────────────────────
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
# sandbox | development | production
PLAID_ENV=sandbox

# ── Twilio (SMS) ─────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_FROM=+15550000000

# ── SendGrid (Email) ─────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=alerts@yourdomain.com

# ── App ──────────────────────────────────────
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
